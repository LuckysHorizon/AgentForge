# Select provider
LLM_PROVIDER=groq

# Replace this placeholder with a valid LiteLLM provider/model identifier.
LLM_MODEL=groq/your-model-id

# Use the selected provider's key below, or set LLM_API_KEY.
OPENAI_API_KEY=
GROQ_API_KEY=your_groq_api_key
ANTHROPIC_API_KEY=

# Pricing per 1 million tokens (USD)
PRICE_INPUT_PER_MILLION=0.10
PRICE_OUTPUT_PER_MILLION=0.50